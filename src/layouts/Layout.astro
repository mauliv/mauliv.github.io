---
import '../styles/global.css';
import { siteIndex } from '../lib/routes';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description =
    'Fullstack and EdTech Engineer: Web, Mobile, AR & Institutional Systems. Production web platforms, EdTech/XR engineering, and higher-education operations.',
} = Astro.props;

const icons: Record<string, string> = {
  home: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  it: '<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>',
  work: '<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>',
  international: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  credentials:
    '<path d="M15 12h-5"/><path d="M15 8h-5"/><path d="M19 17V5a2 2 0 0 0-2-2H4"/><path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3"/>',
  social:
    '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>',
  networks:
    '<rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/>',
  certificates:
    '<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/>',
  news: '<path d="M15 18h-5"/><path d="M18 14h-8"/><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><rect width="8" height="4" x="10" y="6" rx="1"/>',
  publications:
    '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  writing: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/>',
  testimonials:
    '<path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/><path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/>',
  contact: '<path d="M4 4h16v16H4z" fill="none"/><path d="M4 6l8 6 8-6"/>',
};

// Home is nav-only — it must not appear in the homepage Index list itself.
const homeItem = { href: '/', label: 'Home', icon: 'home' };
const primaryItems = siteIndex.slice(0, 3);
const secondaryItems = siteIndex.slice(3);
const baseLinkClass =
  'min-h-11 items-center gap-1.5 rounded-sm px-2.5 text-neutral-700 transition-colors hover:text-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 focus-visible:ring-offset-1 dark:text-neutral-200 dark:hover:text-neutral-100';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <title>{title} — Alifah Mauliddin Nur Ikhsan</title>
    <meta name="description" content={description} />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class={`min-h-screen text-[#1e1e1e] font-sans antialiased dark:text-[#dadadb] ${Astro.url.pathname.split('/').filter(Boolean).length >= 2 ? 'bg-[#ffffff] dark:bg-[#1d1e20]' : 'bg-[#f5f5f5] dark:bg-[#1d1e20]'}`}>
    <header class="mx-auto w-full max-w-3xl px-6 pt-10 md:pt-16">
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
        <!-- Primary links + labeled Index disclosure (zero-JS), single-row responsive at every width -->
        <nav class="flex min-w-0 items-center gap-y-0.5 text-sm font-medium" aria-label="Primary">
          <a href={homeItem.href} class={`inline-flex ${baseLinkClass}`} aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>
            <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons[homeItem.icon]} />
            <span>{homeItem.label}</span>
          </a>
          {
            primaryItems.map((item) => (
              <a href={item.href} class={`hidden md:inline-flex ${baseLinkClass}`}>
                <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
                <span>{item.label}</span>
              </a>
            ))
          }
          <a href="/contact" class={`hidden md:inline-flex ${baseLinkClass}`}>
            <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons.contact} />
            <span>Contact</span>
          </a>
          <a href="/docs/Alifah-Mauliddin-CV-2026.pdf" download="Alifah-Mauliddin-CV-2026.pdf" class={`hidden md:inline-flex ${baseLinkClass}`}>
            <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="12" y2="18"/><line x1="15" y1="15" x2="12" y2="18"/></svg>
            <span>CV</span>
          </a>
          <details id="nav-dropdown" class="group relative">
            <summary class={`inline-flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-sm px-2.5 text-neutral-700 transition-colors hover:text-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 focus-visible:ring-offset-1 dark:text-neutral-200 dark:hover:text-neutral-100 [&::-webkit-details-marker]:hidden`}>
              <span>Index</span>
              <svg aria-hidden="true" class="h-3 w-3 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div
              role="region"
              aria-label="Secondary navigation"
              class="absolute right-0 top-full z-20 mt-1 w-64 rounded-lg border border-neutral-200 bg-white py-1 shadow-lg dark:border-neutral-700 dark:bg-[#2e2e33]"
            >
              <!-- Mobile-only links for primary sections -->
              <div class="md:hidden border-b border-neutral-100 pb-1 mb-1 dark:border-neutral-700/80">
                {
                  primaryItems.map((item) => (
                    <a href={item.href} class={`inline-flex ${baseLinkClass} w-full justify-start`}>
                      <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
                      <span>{item.label}</span>
                    </a>
                  ))
                }
                <a href="/contact" class={`inline-flex ${baseLinkClass} w-full justify-start`}>
                  <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons.contact} />
                  <span>Contact</span>
                </a>
                <a href="/docs/Alifah-Mauliddin-CV-2026.pdf" download="Alifah-Mauliddin-CV-2026.pdf" class={`inline-flex ${baseLinkClass} w-full justify-start text-emerald-700 dark:text-emerald-400 font-medium`}>
                  <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="12" y2="18"/><line x1="15" y1="15" x2="12" y2="18"/></svg>
                  <span>Download CV (PDF)</span>
                </a>
              </div>
              {
                secondaryItems.map((item) => (
                  <a href={item.href} class={`inline-flex ${baseLinkClass} w-full justify-start`}>
                    <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
                    <span>{item.label}</span>
                  </a>
                ))
              }
            </div>
          </details>
        </nav>
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            class="ml-1 shrink-0 rounded-sm border border-neutral-300 p-2.5 min-h-11 min-w-11 text-neutral-500 transition-colors hover:border-neutral-500 hover:text-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 focus-visible:ring-offset-1 dark:border-neutral-700 dark:text-neutral-400 dark:hover:border-neutral-500 dark:hover:text-neutral-100"
          >
          <svg aria-hidden="true" class="h-3.5 w-3.5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
          <svg aria-hidden="true" class="hidden h-3.5 w-3.5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" /></svg>
        </button>
      </div>
    </header>
    <main class="mx-auto w-full max-w-3xl px-6 pt-8 pb-6 sm:pt-10 sm:pb-8">
      <slot />
    </main>
    <footer class="mx-auto mt-8 w-full max-w-3xl border-t border-neutral-200 py-6 text-center text-sm text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
      <p>
        &copy; {new Date().getFullYear()} · All rights reserved.
      </p>
      <p class="mt-1.5">
        <a href="/contact" class="underline underline-offset-4 hover:text-neutral-900 dark:hover:text-neutral-100">Contact me</a>
      </p>
    </footer>
    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });

      // Escape-to-close handler for the Index details dropdown (Antislop F-08)
      const navDropdown = document.getElementById('nav-dropdown') as HTMLDetailsElement | null;
      if (navDropdown) {
        navDropdown.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && navDropdown.open) {
            navDropdown.open = false;
            navDropdown.querySelector('summary')?.focus();
          }
        });
      }
    </script>
  </body>
</html>
