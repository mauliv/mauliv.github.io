// Resolver helper
function resolveConfig(slugKey: string, nameKey: string): IconConfig {
  const target = (nameKey || slugKey || '').toLowerCase();
  if (iconConfigs[target]) {
    return iconConfigs[target];
  }
  for (const key of Object.keys(iconConfigs)) {
    if (key !== 'default' && target.includes(key)) {
      return iconConfigs[key];
    }
  }
  return iconConfigs.default;
}

const config = resolveConfig(slug, name);
const activeImage = image || config.image;

// Size configuration
const sizeMap = {
  sm: {
    box: 'h-8 w-8 min-w-8 rounded-lg',
    svg: 'h-4 w-4',
    img: 'p-1',
  },
  md: {
    box: 'h-10 w-10 min-w-10 rounded-xl',
    svg: 'h-5 w-5',
    img: 'p-1.5',
  },
  lg: {
    box: 'h-12 w-12 min-w-12 rounded-xl',
    svg: 'h-6 w-6',
    img: 'p-2',
  },
};

const currentSize = sizeMap[size] || sizeMap.md;
---
<div
  class={`inline-flex shrink-0 items-center justify-center overflow-hidden border transition-all duration-200 ${currentSize.box} ${activeImage ? 'bg-white dark:bg-white border-neutral-200 dark:border-neutral-300 shadow-xs' : `${config.bgLight} ${config.bgDark} ${config.textLight} ${config.textDark} ${config.borderLight} ${config.borderDark}`} ${className}`}
  aria-hidden="true"
>
  {
    activeImage ? (
      <img
        src={activeImage}
        alt={name || slug}
        class={`h-full w-full object-contain ${currentSize.img}`}
      />
    ) : (
      <svg
        class={currentSize.svg}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={config.svg}
      />
    )
  }
</div>
