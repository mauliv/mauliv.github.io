---
import EvidencePill from './EvidencePill.astro';

interface EvidenceItem {
  type: 'internal-pdf' | 'journal' | 'hki' | 'external-press' | 'video' | 'live' | 'repository';
  label: string;
  url: string;
  is_internal: boolean;
  status: 'available' | 'needs-confirmation' | 'restricted';
}

interface Props {
  title: string;
  summary?: string;
  meta: string;
  evidence?: EvidenceItem[];
  icon: 'education' | 'certification';
  institution_logo?: string;
  href?: string;
}

const { title, summary, meta, evidence = [], icon, institution_logo, href } = Astro.props;

const fallbackIcons = {
  education:
    '<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>',
  certification:
    '<path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/>',
};
---
<div class="flex items-start gap-3">
  {
    href ? (
      <a href={href} class="shrink-0 transition-opacity hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 rounded-xl" aria-label={title}>
        {institution_logo ? (
          <div class="inline-flex h-10 w-10 min-w-10 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-neutral-200 bg-white p-1.5 shadow-xs dark:border-neutral-300 dark:bg-white" aria-hidden="true">
            <img src={institution_logo} alt="" class="h-full w-full object-contain" loading="lazy" />
          </div>
        ) : (
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-neutral-200 bg-neutral-50 text-neutral-500 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 shadow-xs"
            aria-hidden="true"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={fallbackIcons[icon]} />
          </span>
        )}
      </a>
    ) : institution_logo ? (
      <div class="inline-flex h-10 w-10 min-w-10 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-neutral-200 bg-white p-1.5 shadow-xs dark:border-neutral-300 dark:bg-white" aria-hidden="true">
        <img src={institution_logo} alt="" class="h-full w-full object-contain" loading="lazy" />
      </div>
    ) : (
      <span
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-neutral-200 bg-neutral-50 text-neutral-500 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 shadow-xs"
        aria-hidden="true"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={fallbackIcons[icon]} />
      </span>
    )
  }
  <div class="min-w-0 flex-1">
    <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
      <h3 class="break-words text-sm font-medium dark:text-neutral-100">
        {
          href ? (
            <a href={href} class="hover:underline underline-offset-2">
              {title}
            </a>
          ) : (
            title
          )
        }
      </h3>
      <span class="break-words font-mono text-xs text-neutral-500 dark:text-neutral-400">{meta}</span>
    </div>
    {summary && <p class="mt-1 break-words font-serif text-sm text-neutral-600 dark:text-neutral-300">{summary}</p>}
    {
      evidence.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-1.5">
          {evidence.map((e) => (
            <EvidencePill type={e.type} label={e.label} url={e.url} status={e.status} />
          ))}
        </div>
      )
    }
  </div>
</div>
