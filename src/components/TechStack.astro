---

<section id="stack" class="mt-16 scroll-mt-20" aria-label="Skills & Tech Stack">
  <!-- Section Title with Code/Stack Icon -->
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2.5">
