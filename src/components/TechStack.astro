        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-4.5 w-4.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
        </svg>
      </div>
      <div>
        <h2 class="text-balance text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
          Skills & Tech Stack
        </h2>
        <p class="font-serif text-xs text-neutral-500 dark:text-neutral-400">
          Full-stack web systems, mobile AR, cloud architecture, creative media, office productivity, and legal immigration operations.
        </p>
      </div>
    </div>
  </div>

  <!-- Interactive Category Pills (Web & AR default, All on the very right) -->
  <div class="mt-4 flex flex-wrap items-center gap-1.5" role="tablist" aria-label="Filter skills by category">
    {
      categories.map((c, i) => (
        <button
          type="button"
          data-filter={c.id}
          class={`skill-tab-btn inline-flex min-h-8 items-center gap-1.5 rounded-full px-3 py-1 font-mono text-xs transition-all cursor-pointer ${
            i === 0
              ? 'bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 shadow-xs'
              : 'border border-neutral-200 bg-white text-neutral-600 hover:border-neutral-400 hover:text-neutral-900 dark:border-neutral-700 dark:bg-neutral-800/80 dark:text-neutral-300 dark:hover:border-neutral-500 dark:hover:text-neutral-100'
          }`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          <span>{c.label}</span>
          <span class="text-[10px] opacity-70">({c.count})</span>
        </button>
      ))
    }
  </div>

  <!-- Tech Grid Container -->
  <div class="mt-4 rounded-lg border border-[#eeeeee] bg-[#ffffff] p-4 sm:p-5 dark:border-[#333333] dark:bg-[#2e2e33]">
    <!-- 
      21st.dev personal-site-kit-v2 hover effect:
      The parent UL has `skills-group`. When hovering anywhere over the group,
      all icons dim to grayscale. The actively hovered `skill-item` retains full color
      and smoothly scales up via CSS transform.
    -->
    <ul
      id="skills-grid"
      class="skills-group grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-7 gap-1.5 sm:gap-2"
    >
      {
        skills.map((item) => (
          <li
            data-category={item.category}
            style={item.category === defaultCategory ? '' : 'display: none;'}
            class="skill-item relative flex flex-col items-center justify-between rounded-lg border border-transparent p-2 transition-all duration-200 hover:border-neutral-200 hover:bg-neutral-50/90 dark:hover:border-neutral-700/80 dark:hover:bg-neutral-800/60"
            title={`${item.name} — ${item.badge ?? item.categoryLabel}`}
          >
            <a
              href={item.href ?? '#'}
              class="flex h-full w-full flex-col items-center justify-center gap-1.5 text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 focus-visible:ring-offset-1 rounded-sm"
              aria-label={`${item.name}: ${item.badge ?? item.categoryLabel}`}
            >
              <div class="relative flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center">
                {item.highlight && (
                  <span class="absolute -top-1 -right-1 flex h-2 w-2" title="Featured specialization">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75" />
                    <span class="relative inline-flex h-2 w-2 rounded-full bg-amber-500" />
                  </span>
                )}
                <img
                  src={item.icon}
                  alt={item.name}
                  loading="lazy"
                  class="skill-icon h-6 w-6 sm:h-7 sm:w-7 object-contain"
                />
              </div>

              <div class="w-full">
                <span class="skill-label block truncate font-mono text-[11px] font-medium leading-tight text-neutral-700 transition-colors dark:text-neutral-300">
                  {item.name}
                </span>
                <span class="block truncate text-[9.5px] leading-tight text-neutral-400 transition-colors dark:text-neutral-500">
                  {item.badge}
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Indonesian Immigration & Dual-Discipline Operational Callout (Only shown inside Office & Immigration tab) -->
    <div
      id="immigration-callout"
      style={defaultCategory === 'office-ops' ? '' : 'display: none;'}
