              alt="Direktorat Jenderal Imigrasi Indonesia"
              class="h-9 w-9 rounded-full border border-amber-300/80 bg-white p-0.5 shadow-2xs dark:border-amber-700 dark:bg-neutral-900 object-contain"
            />
          </div>
          <div class="text-amber-950 dark:text-amber-200">
            <div class="flex flex-wrap items-center gap-1.5 font-sans font-semibold text-xs text-amber-900 dark:text-amber-100">
              <span>Indonesian Immigration & Legal Compliance Proficiency</span>
              <span class="rounded bg-amber-200/80 px-1.5 py-0.2 font-mono text-[10px] text-amber-950 dark:bg-amber-900/60 dark:text-amber-200">
                5+ Years Operations Experience
              </span>
            </div>
            <p class="mt-1 font-serif text-[11.5px] leading-relaxed text-amber-900/90 dark:text-amber-300/80">
              Not only for IT: Five consecutive years of operational practice in Republic of Indonesia foreign national stay regulations — <strong>E-Visa System</strong>, <strong>ITAS/KITAS</strong> (Limited Stay Permit), <strong>SKTT Dukcapil</strong> (Civil Domicile), <strong>STM</strong> (Police Reporting), and departure clearance (EPO), backed by official university appointments.
            </p>
          </div>
        </div>
        <div class="shrink-0 self-end sm:self-center">
          <a
            href="/international/io-operations"
            class="inline-flex min-h-9 items-center gap-1 rounded-sm border border-amber-300 bg-white px-2.5 py-1 font-mono text-xs text-amber-900 transition-colors hover:bg-amber-100 hover:text-amber-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 dark:border-amber-800 dark:bg-neutral-900 dark:text-amber-200 dark:hover:bg-amber-950/60 dark:hover:text-amber-100"
          >
            <span>Read Immigration Dossier</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* 
   * Interactive hover effect inspired by https://personal-site-kit-v2.21st.app/
   * When hovering over the skills list, all icons transition to grayscale and dim.
   * The actively hovered item remains in 100% full vibrant color and scales smoothly.
   */
  .skill-icon {
    transition: filter 0.25s ease, opacity 0.25s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .skills-group:hover .skill-icon {
    filter: grayscale(100%);
    opacity: 0.55;
  }

  .skills-group .skill-item:hover .skill-icon {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.15);
  }

  .skills-group .skill-item:hover .skill-label {
    color: #111827;
  }

  :global(.dark) .skills-group .skill-item:hover .skill-label {
    color: #f9fafb;
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-icon {
      transition: none !important;
      transform: none !important;
    }
    .skills-group .skill-item:hover .skill-icon {
      transform: none !important;
    }
  }
</style>

<script>
  // Tab-based interactive category filter
  const buttons = document.querySelectorAll<HTMLButtonElement>('.skill-tab-btn');
  const items = document.querySelectorAll<HTMLElement>('.skill-item');
  const immigrationCallout = document.getElementById('immigration-callout');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      if (!filter) return;

      // Update button styles
      buttons.forEach((b) => {
        b.setAttribute('aria-selected', 'false');
        b.className =
          'skill-tab-btn inline-flex min-h-8 items-center gap-1.5 rounded-full px-3 py-1 font-mono text-xs transition-all cursor-pointer border border-neutral-200 bg-white text-neutral-600 hover:border-neutral-400 hover:text-neutral-900 dark:border-neutral-700 dark:bg-neutral-800/80 dark:text-neutral-300 dark:hover:border-neutral-500 dark:hover:text-neutral-100';
      });

      btn.setAttribute('aria-selected', 'true');
      btn.className =
        'skill-tab-btn inline-flex min-h-8 items-center gap-1.5 rounded-full px-3 py-1 font-mono text-xs transition-all cursor-pointer bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 shadow-xs';

      // Filter grid items
      items.forEach((item) => {
        const cat = item.dataset.category;
        if (filter === 'all' || cat === filter) {
          item.style.display = 'flex';
          item.style.opacity = '1';
        } else {
          item.style.display = 'none';
        }
      });

      // Toggle immigration callout: only visible on 'office-ops' (Office & Immigration) tab
      if (immigrationCallout) {
        if (filter === 'office-ops') {
          immigrationCallout.style.display = 'block';
        } else {
          immigrationCallout.style.display = 'none';
        }
      }
    });
  });
</script>
