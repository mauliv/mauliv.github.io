---
import EvidencePill from './EvidencePill.astro';
import ProjectIcon from './ProjectIcon.astro';

interface EvidenceItem {
  type: 'internal-pdf' | 'journal' | 'hki' | 'external-press' | 'video' | 'live' | 'repository';
  label: string;
  url: string;
  is_internal: boolean;
  status: 'available' | 'needs-confirmation' | 'restricted';
}

interface Props {
  title: string;
  role: string;
  period: { start: string; end: string };
  track: string;
  slug?: string;
  project_logo?: string;
  tech_stack?: string[];
  metrics?: { label: string; value: string; provenance?: string }[];
  evidence?: EvidenceItem[];
  summary?: string;
  href?: string;
  institution_logo?: string;
  headingLevel?: 'h2' | 'h3';
}

const {
  title,
  role,
  period,
  track,
  slug,
  project_logo,
  tech_stack = [],
  metrics = [],
  evidence = [],
  summary,
  href,
  institution_logo,
  headingLevel = 'h3',
} = Astro.props;

const Heading = headingLevel;
const cardImage = (project_logo === '/logos/io-uny.png' || slug === 'io-uny-homepage') ? '/logos/io-kotak.png' : project_logo;
---
<article class="group rounded-xl border border-neutral-200 bg-white p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-neutral-300 hover:shadow-sm dark:border-neutral-800 dark:bg-[#222226] dark:hover:border-neutral-700">
  <div class="flex items-start gap-4">
    <!-- Distinct Project Icon Badge -->
    {
      href ? (
        <a href={href} tabindex="-1" aria-hidden="true" class="shrink-0 transition-transform hover:scale-105 focus:outline-none">
          <ProjectIcon slug={slug} image={cardImage} size="md" />
        </a>
      ) : (
        <ProjectIcon slug={slug} image={cardImage} size="md" />
      )
    }

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
        <Heading class="text-base sm:text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
          {
            href ? (
              <a
                href={href}
                class="hover:underline underline-offset-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 focus-visible:ring-offset-1 rounded-sm"
              >
                {title}
              </a>
            ) : (
              title
            )
          }
        </Heading>
        <span class="font-mono text-xs text-neutral-500 dark:text-neutral-400 shrink-0">
          {period.start} – {period.end}
        </span>
      </div>

      <!-- Role & Track subtitle -->
      <div class="mt-1 flex flex-wrap items-center gap-2">
        <span class="font-mono text-xs text-neutral-600 dark:text-neutral-300">{role}</span>
        <span class="inline-block h-1 w-1 rounded-full bg-neutral-300 dark:bg-neutral-500" aria-hidden="true"></span>
        <span class="font-mono text-xs uppercase tracking-wider rounded px-1.5 py-0.5 bg-neutral-100 text-neutral-600 border border-neutral-200/80 dark:bg-neutral-800 dark:text-neutral-400 dark:border-neutral-700/60">
          {track}
        </span>
      </div>

      <!-- Concise Project Summary -->
      {
        summary && (
          <p class="mt-2.5 text-sm sm:text-base leading-relaxed text-neutral-600 dark:text-neutral-300">
            {summary}
          </p>
        )
      }

      <!-- Key Metrics Highlights -->
      {
        metrics.length > 0 && (
          <ul class="mt-3 space-y-1">
            {metrics.map((m) => (
              <li class="font-mono text-xs text-neutral-600 dark:text-neutral-300 flex items-baseline gap-1.5">
                <span class="text-neutral-400 dark:text-neutral-400 shrink-0" aria-hidden="true">▸</span>
                <span>
                  <strong class="font-semibold text-neutral-700 dark:text-neutral-200">{m.label}:</strong> {m.value}
                </span>
              </li>
            ))}
          </ul>
        )
      }

      <!-- Tech Stack Badges (Reference1 Style) -->
      {
        tech_stack.length > 0 && (
          <div class="mt-3.5 flex flex-wrap gap-1.5" aria-label="Tech stack">
            {tech_stack.map((t) => (
              <span class="inline-flex items-center rounded-md bg-neutral-100 px-2 py-0.5 font-mono text-[11px] text-neutral-700 border border-neutral-200/60 dark:bg-neutral-800/80 dark:text-neutral-300 dark:border-neutral-700/60">
                {t}
              </span>
            ))}
          </div>
        )
      }

      <!-- Proof & Evidence Pills -->
      {
        evidence.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-1.5 border-t border-neutral-100 pt-3 dark:border-neutral-800">
            {evidence.map((e) => (
              <EvidencePill type={e.type} label={e.label} url={e.url} status={e.status} />
            ))}
          </div>
        )
      }
    </div>
  </div>
</article>
