---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectIcon from '../components/ProjectIcon.astro';
import EvidencePill from '../components/EvidencePill.astro';
import CredentialRow from '../components/CredentialRow.astro';

const credentials = await getCollection('credentials');
const leadership = credentials.filter((c) => 'leadership_scope' in c.data);
const plant = await getEntry('systems', 'plant-escape-ar');

const byDateDesc = (a: { data: { period: { start: string } } }, b: { data: { period: { start: string } } }) =>
  a.data.period.start < b.data.period.start ? 1 : a.data.period.start > b.data.period.start ? -1 : 0;

// Section A — Education (latest first)
const education = credentials.filter((c) => c.data.credential_type === 'degree').sort(byDateDesc);

// Section B — Leadership (latest first)
const leadershipRows = [...leadership].sort(byDateDesc);

// Section D — Certifications, Licenses & Tests (latest first)
const certsRaw = credentials
  .filter((c) => ['license', 'certification', 'test'].includes(c.data.credential_type))
  .sort(byDateDesc);
const bangkit = certsRaw.filter((c) => c.data.title.includes('Bangkit'));
const bnsp = certsRaw.filter((c) => c.data.title.includes('BNSP'));
const certsRest = certsRaw.filter((c) => !c.data.title.includes('Bangkit') && !c.data.title.includes('BNSP'));
const certs = [...bangkit, ...bnsp, ...certsRest];

// Section C — Publications & IP (from Plant Escape frontmatter + thesis)
const thesis = credentials.find((c) => c.data.thesis_title);
const hkiPills = plant?.data.evidence.filter((e) => e.type === 'hki' || e.type === 'journal') ?? [];
const thesisPills =
  thesis?.data.evidence.filter((e) => e.label.toLowerCase().includes('thesis')) ?? [];

const languages = [
  { flag: '/flags/id.svg', name: 'Indonesian', level: 'Native' },
  { flag: null, script: '\uA997\uA9AE', name: 'Javanese', level: 'Native' },
  { flag: '/flags/my.svg', name: 'Malay', level: 'Working Familiarity' },
  { flag: '/flags/gb.svg', name: 'English', level: 'Professional' },
];

function meta(d: { issuing_body?: string; institution?: string; validity?: string; conferred_date?: string }) {
  const issuer = d.issuing_body ?? d.institution ?? '';
  const when = d.validity ?? d.conferred_date ?? '';
  return [issuer, when].filter(Boolean).join(' · ');
}
---
<Layout title="Credentials" description="Verification hub — education, leadership, publications, and certifications with direct proof links.">
  <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Credentials' }]} />
  <div class="mt-4 flex items-center gap-2.5">
    <ProjectIcon name="credentials" size="sm" />
    <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">Credentials</h1>
  </div>
  <p class="mt-2 font-serif text-neutral-500 dark:text-neutral-400">Verification hub — every claim links to primary evidence.</p>
  <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 font-mono text-xs text-neutral-500 dark:text-neutral-400">
    <span class="text-neutral-400 dark:text-neutral-500">Languages:</span>
    {
      languages.map((l) => (
        <span class="inline-flex items-center gap-1.5">
          {l.flag ? (
            <img
              src={l.flag}
              alt=""
              width="16"
              height="12"
              class="inline-block h-3 w-4 shrink-0 rounded-[2px] object-cover shadow-sm ring-1 ring-neutral-200 dark:ring-neutral-700"
            />
          ) : (
            <span class="leading-none" aria-hidden="true">{l.script}</span>
          )}
          <span>
            {l.name} ({l.level})
          </span>
        </span>
      ))
    }
  </p>

  <!-- A. Education & Academic Heritage -->
  <!-- A. Education & Academic Heritage -->
  <section class="mt-12 border-t border-neutral-300 pt-6 dark:border-neutral-700" aria-labelledby="sec-education">
    <div class="flex items-center gap-2.5">
      <ProjectIcon name="operations" size="sm" />
      <h2 id="sec-education" class="text-balance text-xl font-semibold tracking-tight dark:text-neutral-100">Education &amp; Academic Heritage</h2>
    </div>
    <p class="mt-1.5 font-serif text-sm text-neutral-500 dark:text-neutral-400">Formal degrees and academic heritage.</p>
    <div class="mt-4 rounded-xl border border-neutral-200 bg-white p-5 shadow-sm dark:border-neutral-800 dark:bg-[#222226]">
      <div class="divide-y divide-neutral-100 dark:divide-neutral-800">
        {education.map(({ data: d }) => (
          <div class="py-4 first:pt-0 last:pb-0">
            <CredentialRow
              title={d.title}
              summary={d.summary}
              meta={meta(d)}
              evidence={d.evidence}
              icon="education"
              institution_logo={d.institution_logo}
              href={`/credentials/${d.slug}`}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- B. Leadership & Impact -->
  <section class="mt-12 border-t border-neutral-300 pt-6 dark:border-neutral-700" aria-labelledby="sec-leadership">
    <div class="flex items-center gap-2.5">
      <ProjectIcon name="mobility" size="sm" />
      <h2 id="sec-leadership" class="text-balance text-xl font-semibold tracking-tight dark:text-neutral-100">Leadership &amp; Impact</h2>
    </div>
    <p class="mt-1.5 font-serif text-sm text-neutral-500 dark:text-neutral-400">National and organizational leadership roles.</p>
    <div class="mt-4 space-y-4">
      {
        leadershipRows.map((entry) => (
          <ProjectCard
            title={entry.data.title}
            role={entry.data.role}
            period={entry.data.period}
            track="leadership"
            slug={entry.data.slug}
            metrics={entry.data.metrics}
            evidence={entry.data.evidence}
            summary={entry.data.summary}
            href={`/credentials/${entry.data.slug}`}
          />
        ))
      }
    </div>
  </section>

  <!-- C. Publications & Intellectual Property -->
  <section class="mt-12 border-t border-neutral-300 pt-6 dark:border-neutral-700" aria-labelledby="sec-pubs">
    <div class="flex items-center gap-2.5">
      <ProjectIcon name="publications" size="sm" />
      <h2 id="sec-pubs" class="text-balance text-xl font-semibold tracking-tight dark:text-neutral-100">Publications &amp; Intellectual Property</h2>
    </div>
    <p class="mt-1.5 font-serif text-sm text-neutral-500 dark:text-neutral-400">Published research, registered IP, and undergraduate thesis.</p>
    <div class="mt-4 rounded-xl border border-neutral-200 bg-white p-5 shadow-sm dark:border-neutral-800 dark:bg-[#222226]">
      <div class="divide-y divide-neutral-100 dark:divide-neutral-800">
        {
          plant &&
            plant.data.intellectual_property.map((ip) => (
              <div class="py-4 first:pt-0 last:pb-0">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="break-words text-sm font-medium dark:text-neutral-100">{ip.type}</h3>
                  <span class="break-words font-mono text-xs text-neutral-500 dark:text-neutral-400">No. {ip.number} · {ip.issuing_body}</span>
                </div>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {hkiPills.map((e) => (
                    <EvidencePill type={e.type} label={e.label} url={e.url} status={e.status} />
                  ))}
                </div>
              </div>
            ))
        }
        {
          plant?.data.publications.map((p) => (
            <div class="py-4 first:pt-0 last:pb-0">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="break-words text-sm font-medium dark:text-neutral-100">{p.journal} — {p.focus}</h3>
                <span class="break-words font-mono text-xs text-neutral-500 dark:text-neutral-400">{p.volume} · {p.date}</span>
              </div>
              <div class="mt-2 flex flex-wrap gap-1.5">
                {hkiPills
                  .filter((e) => e.type === 'journal')
                  .map((e) => (
                    <EvidencePill type={e.type} label={e.label} url={e.url} status={e.status} />
                  ))}
              </div>
            </div>
          ))
        }
        {
          thesis && (
            <div class="py-4 first:pt-0 last:pb-0">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="break-words text-sm font-medium dark:text-neutral-100">
                  <a href={`/credentials/${thesis.data.slug}`} class="hover:underline underline-offset-2">
                    Undergraduate Thesis — WebQual 4.0 &amp; IPA (SIMOBY UNY)
                  </a>
                </h3>
                <span class="break-words font-mono text-xs text-neutral-500 dark:text-neutral-400">UNY · 2026</span>
              </div>
              <p class="mt-1 font-serif text-sm text-neutral-600 dark:text-neutral-300">{thesis.data.thesis_title}</p>
              <div class="mt-2 flex flex-wrap gap-1.5">
                {thesisPills.map((e) => (
                  <EvidencePill type={e.type} label={e.label} url={e.url} status={e.status} />
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- D. Industry Certifications, Licenses & Tests -->
  <section class="mt-12 border-t border-neutral-300 pt-6 dark:border-neutral-700" aria-labelledby="sec-certs">
    <div class="flex items-center gap-2.5">
      <ProjectIcon name="terminal" size="sm" />
      <h2 id="sec-certs" class="text-balance text-xl font-semibold tracking-tight dark:text-neutral-100">Industry Certifications, Licenses &amp; Tests</h2>
    </div>
    <p class="mt-1.5 font-serif text-sm text-neutral-500 dark:text-neutral-400">Professional certifications, licenses, and proficiency tests.</p>
    <div class="mt-4 rounded-xl border border-neutral-200 bg-white p-5 shadow-sm dark:border-neutral-800 dark:bg-[#222226]">
      <div class="divide-y divide-neutral-100 dark:divide-neutral-800">
        {certs.map(({ data: d }) => {
          const highlight = d.title.includes('Bangkit') || d.title.includes('BNSP');
          return (
            <div class="py-4 first:pt-0 last:pb-0">
              <div class={highlight ? 'rounded-lg border border-neutral-900 p-4 shadow-sm dark:border-neutral-100' : ''}>
                <CredentialRow
                  title={d.title}
                  summary={d.summary}
                  meta={meta(d)}
                  evidence={d.evidence}
                  icon="certification"
                  institution_logo={d.institution_logo}
                  href={`/credentials/${d.slug}`}
                />
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
