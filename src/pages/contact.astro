---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ProjectIcon from '../components/ProjectIcon.astro';
---
<Layout title="Contact" description="Where to find me online, professional channels, and rules of engagement.">
  <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />

  <div class="mt-4 flex items-center gap-2.5">
    <ProjectIcon name="contact" size="sm" />
    <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">Contact</h1>
  </div>
  <p class="mt-2 text-base text-neutral-600 dark:text-neutral-400">Where to find me online and rules of engagement.</p>

  <section class="mt-10">
    <h2 class="text-balance text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
      Direct Channels
    </h2>
    <p class="mt-1.5 text-sm text-neutral-500 dark:text-neutral-400">
      Email is the most reliable way to reach me.
    </p>
    <div class="mt-4 rounded-lg border border-neutral-200 bg-white p-6 transition-all duration-200 dark:border-neutral-800 dark:bg-[#2e2e33]">
      <ul class="divide-y divide-neutral-200 dark:divide-neutral-800">
        <li class="py-4 first:pt-0 last:pb-0 flex flex-wrap items-center justify-between gap-4">
          <div>
            <div class="font-semibold text-neutral-900 dark:text-neutral-100">Email</div>
            <div class="font-mono text-xs text-neutral-500 dark:text-neutral-400 mt-1">For all inquiries</div>
          </div>
          <a href="mailto:alif.maulidin@gmail.com" class="font-mono text-sm underline underline-offset-4 transition-colors hover:text-neutral-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 focus-visible:ring-offset-1 rounded-sm dark:text-neutral-300 dark:hover:text-neutral-100">alif.maulidin@gmail.com</a>
        </li>
        <li class="py-4 first:pt-0 last:pb-0 flex flex-wrap items-center justify-between gap-4">
          <div>
            <div class="font-semibold text-neutral-900 dark:text-neutral-100">LinkedIn</div>
            <div class="font-mono text-xs text-neutral-500 dark:text-neutral-400 mt-1">Professional network</div>
          </div>
          <a href="https://www.linkedin.com/in/maulidinalif" target="_blank" rel="noopener noreferrer" class="font-mono text-sm underline underline-offset-4 transition-colors hover:text-neutral-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 focus-visible:ring-offset-1 rounded-sm dark:text-neutral-300 dark:hover:text-neutral-100">/in/maulidinalif</a>
        </li>
        <li class="py-4 first:pt-0 last:pb-0 flex flex-wrap items-center justify-between gap-4">
          <div>
            <div class="font-semibold text-neutral-900 dark:text-neutral-100">GitHub</div>
            <div class="font-mono text-xs text-neutral-500 dark:text-neutral-400 mt-1">Code &amp; systems</div>
          </div>
          <a href="https://github.com/mauliv" target="_blank" rel="noopener noreferrer" class="font-mono text-sm underline underline-offset-4 transition-colors hover:text-neutral-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 focus-visible:ring-offset-1 rounded-sm dark:text-neutral-300 dark:hover:text-neutral-100">@mauliv</a>
        </li>
      </ul>
    </div>
  </section>

  <section class="mt-12 border-t border-neutral-200 pt-8 dark:border-neutral-800">
    <h2 class="text-balance text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
      Context &amp; Routing
    </h2>
    <p class="mt-1.5 text-sm text-neutral-500 dark:text-neutral-400">
      To help me respond faster, please align your inquiry with the appropriate context.
    </p>
    <div class="mt-4 rounded-lg border border-neutral-200 bg-white p-6 transition-all duration-200 dark:border-neutral-800 dark:bg-[#2e2e33]">
      <ul class="divide-y divide-neutral-200 dark:divide-neutral-800">
        <li class="py-4 first:pt-0 last:pb-0">
          <div class="font-semibold text-neutral-900 dark:text-neutral-100">IT, Web Systems &amp; XR</div>
          <p class="mt-1 text-sm sm:text-base leading-relaxed text-neutral-600 dark:text-neutral-300">
            For software engineering, networking infrastructure, or technical consultation. Please include high-level requirements or system scale.
          </p>
        </li>
        <li class="py-4 first:pt-0 last:pb-0">
          <div class="font-semibold text-neutral-900 dark:text-neutral-100">International Office &amp; Delegations</div>
          <p class="mt-1 text-sm sm:text-base leading-relaxed text-neutral-600 dark:text-neutral-300">
            For matters regarding university partnerships, diplomatic visits, or student mobility programs. If this is an institutional matter, please indicate your university/agency.
          </p>
        </li>
      </ul>
    </div>
  </section>
</Layout>
