                      </blockquote>
                    )
                  }
                  {r.pills.length > 0 && (
                    <div class="mt-2.5 flex flex-wrap gap-1.5">
                      {r.pills.map((e) => (
                        <EvidencePill type={e.type} label={e.label} url={e.url} status={e.status} />
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
        </div>
        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
          <a
            href={c.more[0].href}
            class="inline-flex min-h-11 items-center rounded-md border border-neutral-900 bg-neutral-900 px-4 font-mono text-xs text-white transition-colors hover:bg-neutral-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 focus-visible:ring-offset-1 dark:border-neutral-100 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-300"
