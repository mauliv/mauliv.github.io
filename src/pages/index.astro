---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import EvidencePill from '../components/EvidencePill.astro';
import ProjectIcon from '../components/ProjectIcon.astro';
import TechStack from '../components/TechStack.astro';
import { entryHref, siteIndex, type CollectionId } from '../lib/routes';
import { gatherEvidence, certificatesRows } from '../lib/evidence-index';
import { publishedTestimonials } from '../lib/testimonials';

const systems = await getCollection('systems');
const operations = await getCollection('operations');
const credentials = await getCollection('credentials');
const writings = await getCollection('writings');
const press = await getCollection('press');
const ops = operations.find((e) => e.data.slug === 'io-operations');
const opsData = ops?.data;

// Featured rows pull real evidence from real entries (nothing hardcoded).
const pemilwa = await getEntry('systems', 'pemilwa-evoting');
const plantEscape = await getEntry('systems', 'plant-escape-ar');
const mtqmEntry = await getEntry('systems', 'mtqm-competition-portal');
const php2d = await getEntry('credentials', 'php2d-msme');
const restek = await getEntry('credentials', 'restek-chairman');
const gcfEntry = await getEntry('operations', 'gcf-2024');
const gloshipEntry = await getEntry('operations', 'gloship-2025');
const aasvetEntry = await getEntry('operations', 'aasvet-2023');
const etssEntry = await getEntry('operations', 'etss-2024');
const incotepdEntry = await getEntry('operations', 'incotepd-2024');

interface Row {
  title: string;
  meta: string;
  summary: string;
  href: string;
  pills: { type: any; label: string; url: string; is_internal: boolean; status: any }[];
  excerpt?: string;
  slug?: string;
  iconName?: string;
  image?: string;
}

const mkRow = (
  title: string,
  meta: string,
  summary: string,
  href: string,
  pills: { type: any; label: string; url: string; is_internal: boolean; status: any }[] | undefined,
  excerpt?: string,
  slug?: string,
  iconName?: string,
  image?: string,
): Row => ({ title, meta, summary, href, pills: (pills ?? []).slice(0, 3), excerpt, slug, iconName, image });

const sectionIcons: Record<string, string> = {
  it: 'terminal',
  international: 'operations',
};

const competencies = [
  {
    id: 'it',
    track: 'web-systems',
    title: 'IT — Web Systems, AR & Infrastructure',
    blurb:
      'Production web platforms built for real concurrency, spatial AR learning tools, and the network infrastructure underneath them.',
    rows: [
      pemilwa && mkRow(pemilwa.data.title, `${pemilwa.data.role} · ${pemilwa.data.period.start}–${pemilwa.data.period.end}`, pemilwa.data.summary ?? '', entryHref('systems', pemilwa.data.slug), pemilwa.data.evidence, pemilwa.data.excerpt, 'pemilwa-evoting'),
      plantEscape && mkRow(plantEscape.data.title, `${plantEscape.data.role} · ${plantEscape.data.period.start}`, plantEscape.data.summary ?? '', entryHref('systems', plantEscape.data.slug), plantEscape.data.evidence, plantEscape.data.excerpt, 'plant-escape-ar'),
      mtqmEntry && mkRow(mtqmEntry.data.title, `${mtqmEntry.data.role} · ${mtqmEntry.data.period.start}–${mtqmEntry.data.period.end}`, mtqmEntry.data.summary ?? '', entryHref('systems', mtqmEntry.data.slug), mtqmEntry.data.evidence, mtqmEntry.data.excerpt, 'mtqm-competition-portal', undefined, mtqmEntry.data.project_logo),
    ].filter(Boolean) as Row[],
    more: [
      { label: `[View all ${systems.length} projects]`, href: '/it' },
      { label: 'EdTech & XR section', href: '/it#sec-edtech-xr' },
      { label: 'Networks & IT support', href: '/networks' },
    ],
  },
  {
    id: 'international',
    track: 'leadership',
    title: 'International Affairs — Campus Operations, Delegations & Events',
    blurb:
      'Five years of higher education operations experience: legal immigration compliance, diplomatic delegation hosting, flagship cultural festivals, and international mobility administration.',
    rows: [
      mkRow(
        'International Office operations & institutional mandates',
        'Student Employee, International Office · 2021–present',
        'Five consecutive years of campus operations experience at the International Office. Managed legal immigration compliance for foreign nationals (E-Visa, ITAS, STM, SKTT), foreign student pastoral care, and institutional digital PR, backed by official university appointments.',
        '/international/io-operations',
        opsData?.evidence.filter((e: any) => e.type === 'internal-pdf' && e.status === 'available'),
        opsData?.excerpt,
        undefined,
        'operations',
      ),
      mkRow(
        'Flagship international event operations & student committee coordination',
        'GCF 2024, GLOSHIP 2025, InCoTEPD 2024, ETSS 2024 & AASVET 2023 · Student Committee Coordinator',
        'Operational committee leadership across UNY flagship events: 11th Global Culture Festival, Global Partnership Forum, InCoTEPD 2024 (SEAMEO QITEP), EcoEduTech Doctoral Summer School, and the 19th AASVET International Conference.',
        '/international#sec-events',
        [
          ...(gcfEntry?.data.evidence.filter((e: any) => e.type === 'external-press') ?? []),
          ...(gloshipEntry?.data.evidence.filter((e: any) => e.type === 'external-press') ?? []),
          ...(incotepdEntry?.data.evidence.filter((e: any) => e.type === 'live') ?? []),
          ...(aasvetEntry?.data.evidence.filter((e: any) => e.type === 'live') ?? []),
          ...(etssEntry?.data.evidence.filter((e: any) => e.type === 'live') ?? []),
        ],
        undefined,
        undefined,
        'events',
      ),
      mkRow(
        'Diplomatic delegation hosting & bilateral partnerships',
        'Nanyang Poly (7 batches) · Western Sydney Univ (3 batches) · Bilateral visits',
        'Protocol logistics, campus immersion programs, and bilateral academic visits for 10 recurring short-course batches from Singapore and Australia, alongside delegations from UiTM, UMPSA, PKNU, and Philippine Normal University.',
        '/international#sec-delegations',
        [
          {
            type: 'external-press',
            label: 'NYP Delegation Coverage',
            url: 'https://io.uny.ac.id/content/nyp-singapore-visits-uny',
            is_internal: false,
            status: 'available',
          },
        ],
        undefined,
        undefined,
        'delegations',
      ),
      mkRow(
        'Global academic mobility programs: Japan, South Korea, Vietnam, Malaysia',
        '4 programs · 2018–2024',
        'In-person and virtual exchange programs across four countries, from the JST Sakura Science Program to the PKNU International Summer School.',
        '/international#sec-mobility',
        undefined,
        undefined,
        undefined,
        'mobility',
      ),
    ] as Row[],
    more: [
      { label: '[View all international programs & operations]', href: '/international' },
      { label: 'Open the operations dossier', href: '/international/io-operations' },
      { label: 'Credentials & documents', href: '/credentials' },
    ],
  },
];

interface ImpactItem {
  value: string;
  label: string;
  href: string;
  slug?: string;
  name?: string;
  pill?: { type: any; label: string; url: string; status?: any };
  pillLabel?: string;
}

const impact: ImpactItem[] = [
  {
    value: '100%',
    label: 'zero-downtime university elections',
    href: entryHref('systems', 'pemilwa-evoting'),
    slug: 'pemilwa-evoting',
    pill: pemilwa?.data.evidence.find((e) => e.type === 'live'),
    pillLabel: 'Live System',
  },
  {
    value: '2',
    label: 'official HKI copyrights granted',
    href: entryHref('systems', 'plant-escape-ar'),
    slug: 'plant-escape-ar',
    pill: plantEscape?.data.evidence.find((e) => e.type === 'hki'),
    pillLabel: 'HKI Copyrights',
  },
  {
    value: '8,000+',
    label: 'organic @io.uny followers',
    href: '/social-media',
    name: 'social',
    pill: opsData?.evidence.find((e) => e.type === 'external-press'),
    pillLabel: '@io.uny Channel',
  },
  {
    value: 'IDR 44.6M',
    label: 'national rural digitization grant (PHP2D) secured & deployed',
    href: entryHref('credentials', 'php2d-msme'),
    slug: 'php2d-msme',
    pill: php2d?.data.evidence.find((e) => e.type === 'internal-pdf'),
    pillLabel: 'Ministry Grant Award (PHP2D)',
  },
];

const languages = [
  { flag: '/flags/gb.svg', name: 'English', level: 'Professional' },
  { flag: '/flags/id.svg', name: 'Indonesian', level: 'Native' },
  { flag: '/flags/my.svg', name: 'Malay', level: 'Working Familiarity' },
  { flag: null, script: '\uA997\uA9AE', name: 'Javanese', level: 'Native' },
];

const counts: Record<string, number> = {
  '/it': systems.length,
  '/international': operations.length,
  '/credentials': credentials.length,
  '/social-media': 1,
  '/writing': writings.length,
  '/news': press.length,
  '/certificates': (await certificatesRows()).length,
  '/publications': (await gatherEvidence()).filter((r) => r.pill.type === 'journal').length,
  '/networks': 6,
  '/testimonials': (await publishedTestimonials()).length,
};
const indexLinks = siteIndex.map((i) => ({ href: i.href, label: i.label, count: counts[i.href] ?? 0 }));
---
<Layout title="Home">
  <!-- Masthead: face + name -->
  <div class="flex items-center gap-4">
    <img
      src="/photo.jpg"
      alt="Portrait of Alifah Mauliddin Nur Ikhsan"
      width="64"
      height="64"
      class="h-16 w-16 shrink-0 rounded-full object-cover object-top ring-1 ring-neutral-200 dark:ring-neutral-700"
    />
    <div class="min-w-0">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 sm:whitespace-nowrap">Alifah Mauliddin Nur Ikhsan, S.T.</h1>
      <p class="mt-1 text-base font-medium text-neutral-800 dark:text-neutral-200">Fullstack and EdTech Engineer — Web, Mobile, AR &amp; Institutional Systems</p>
    </div>
  </div>

  <p class="mt-5 max-w-2xl text-base sm:text-[1.0625rem] leading-relaxed text-neutral-700 dark:text-neutral-300">
    I build the platforms that universities and learning companies run on — from classroom-tested AR educational software to zero-downtime high-concurrency web systems.
  </p>

  <p class="mt-3 max-w-2xl text-base sm:text-[1.0625rem] leading-relaxed text-neutral-700 dark:text-neutral-300">
    Over 5+ years at Universitas Negeri Yogyakarta (UNY), I architected the production systems the institution depends on: an e-voting platform serving 39,725 voters with 100% uptime across 5 election cycles, mobile AR learning tools field-tested in classrooms with 2 national IP copyrights (HKI), and the international office gateway routing 4 audience pathways across 11 mobility programs. Alongside engineering, I managed statutory immigration compliance for 200+ foreign scholars and grew the university's international office Instagram from 0 to 8,000+ followers.
  </p>

  <!-- Quick Actions / Recruiter CTA -->
  <div class="mt-5 flex flex-wrap items-center gap-2.5 text-xs font-mono">
    <a
      href="mailto:alif.maulidin@gmail.com"
      class="inline-flex min-h-8 items-center gap-1.5 rounded-md border border-neutral-300 bg-white px-2.5 py-1 text-neutral-800 transition-colors hover:border-neutral-900 hover:text-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 dark:border-neutral-700 dark:bg-[#222226] dark:text-neutral-200 dark:hover:border-neutral-400 dark:hover:text-white"
    >
      <svg class="h-3.5 w-3.5 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      alif.maulidin@gmail.com
    </a>
    <a
      href="/docs/Alifah-Mauliddin-CV-2026.pdf"
      download="Alifah-Mauliddin-CV-2026.pdf"
      class="inline-flex min-h-8 items-center gap-1.5 rounded-md border border-emerald-600/30 bg-emerald-50 px-2.5 py-1 font-medium text-emerald-800 transition-colors hover:bg-emerald-100 hover:text-emerald-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 dark:border-emerald-500/30 dark:bg-emerald-950/40 dark:text-emerald-300 dark:hover:bg-emerald-900/60"
    >
      <svg class="h-3.5 w-3.5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      Download CV (PDF)
    </a>
    <a
      href="https://linkedin.com/in/maulidinalif"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-8 items-center gap-1.5 rounded-md border border-neutral-300 bg-white px-2.5 py-1 text-neutral-800 transition-colors hover:border-neutral-900 hover:text-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 dark:border-neutral-700 dark:bg-[#222226] dark:text-neutral-200 dark:hover:border-neutral-400 dark:hover:text-white"
    >
      <svg class="h-3.5 w-3.5 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
      LinkedIn
    </a>
    <a
      href="https://github.com/mauliv"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-8 items-center gap-1.5 rounded-md border border-neutral-300 bg-white px-2.5 py-1 text-neutral-800 transition-colors hover:border-neutral-900 hover:text-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 dark:border-neutral-700 dark:bg-[#222226] dark:text-neutral-200 dark:hover:border-neutral-400 dark:hover:text-white"
    >
      <svg class="h-3.5 w-3.5 text-neutral-700 dark:text-neutral-300" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
      GitHub
    </a>
  </div>

  <!-- Target, Credentials & Languages Overview -->
  <div class="mt-5 rounded-lg border border-neutral-200/80 bg-neutral-50/60 p-3.5 text-xs font-mono dark:border-neutral-800/80 dark:bg-neutral-900/40">
    <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-[90px_1fr] sm:items-baseline">
      <!-- Target -->
      <span class="font-semibold text-neutral-700 dark:text-neutral-300">Target:</span>
      <div class="leading-relaxed text-neutral-600 dark:text-neutral-300">
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block h-2 w-2 shrink-0 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Fullstack or EdTech Engineering roles</span>
        </span>
        <span class="mx-1.5 text-neutral-300 dark:text-neutral-600" aria-hidden="true">·</span>
        <span>Yogyakarta, Indonesia (open to remote &amp; relocation)</span>
      </div>

      <!-- Credentials -->
      <span class="font-semibold text-neutral-700 dark:text-neutral-300">Credentials:</span>
      <div class="leading-relaxed text-neutral-600 dark:text-neutral-300">
        <span>S.T. (B.Eng.) in IT, UNY (GPA 3.77 / 4.00)</span>
        <span class="mx-1.5 text-neutral-300 dark:text-neutral-600" aria-hidden="true">·</span>
        <span>TOEIC 925</span>
        <span class="mx-1.5 text-neutral-300 dark:text-neutral-600" aria-hidden="true">·</span>
        <span>EF SET C2</span>
        <span class="mx-1.5 text-neutral-300 dark:text-neutral-600" aria-hidden="true">·</span>
        <span title="National Professional Certification Board (BNSP)">Certified Junior Network Administrator (<abbr title="National Professional Certification Board" class="no-underline">BNSP</abbr>)</span>
      </div>

      <!-- Languages -->
      <span class="font-semibold text-neutral-700 dark:text-neutral-300">Languages:</span>
      <div class="leading-relaxed text-neutral-600 dark:text-neutral-300">
        {
          languages.map((l, idx) => (
            <>
              <span class="inline-flex items-center gap-1.5">
                {l.flag ? (
                  <img src={l.flag} alt="" width="16" height="12" class="inline-block h-3 w-4 shrink-0 rounded-[2px] object-cover shadow-sm ring-1 ring-neutral-200 dark:ring-neutral-700" />
                ) : (
                  <span class="leading-none" aria-hidden="true">{l.script}</span>
                )}
                <span>{l.name} ({l.level})</span>
              </span>
              {idx < languages.length - 1 && (
                <span class="mx-1.5 text-neutral-300 dark:text-neutral-600" aria-hidden="true">·</span>
              )}
            </>
          ))
        }
      </div>
    </div>
  </div>

  <!-- The Career Arc Narrative: Deliberate Evolution -->
  <div class="mt-8 max-w-2xl border-l-2 border-neutral-300 pl-4 py-1 text-sm sm:text-base leading-relaxed text-neutral-600 dark:border-neutral-700 dark:text-neutral-300">
    <p>
      My career began configuring Cisco switches and NAS storage in a vocational high school server room. A national science delegation to Japan (Sakura Science, 2018) opened the door to international work. At university, I became the engineer who builds what the institution actually runs on — the e-voting platform for every annual election, the international office portal, the competition registration system. Along the way, I developed AR learning tools that earned national IP copyrights and grew a university Instagram channel to 8,000+ followers. These aren't separate careers — they're what happens when one engineer sits at the intersection of technology and education for 5 years.
    </p>
  </div>

  <!-- Evidence Trust Signal Notice -->
  <div class="mt-6 flex items-center gap-2 text-xs font-mono text-neutral-500 dark:text-neutral-400">
    <svg class="h-4 w-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
    <span>Every claim on this site links to its primary proof — PDFs, live production systems, journal DOIs, or official registry records.</span>
  </div>

  <!-- Featured artifact: the work itself, with its proof -->
  {
    pemilwa && (
      <section class="mt-16" aria-labelledby="featured">
        <div class="overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-sm transition-all duration-200 dark:border-neutral-800 dark:bg-[#222226]">
          <a
            href={entryHref('systems', pemilwa.data.slug)}
            class="group relative block h-64 w-full overflow-hidden border-b border-neutral-200 bg-neutral-100 sm:h-72 md:h-80 lg:h-96 dark:border-neutral-800 dark:bg-neutral-900"
            aria-label="View Pemilwa E-Voting Platform case study"
          >
            <div class="relative h-full w-full">
              <img
                src="/images/pemilwa/01_landing_page.png"
                alt="Pemilwa E-Voting Platform Landing Page"
                width="1922"
                height="1001"
                class="pemilwa-slide pemilwa-slide-1 absolute inset-0 h-full w-full object-cover object-top"
                loading="eager"
              />
              <img
                src="/images/pemilwa/02_live_count_fakultas.png"
                alt="Pemilwa Real-Time Faculty Turnout Telemetry"
                width="1922"
                height="1085"
                class="pemilwa-slide pemilwa-slide-2 absolute inset-0 h-full w-full object-cover object-top"
                loading="lazy"
              />
              <img
                src="/images/pemilwa/03_rekap_split_columns.png"
                alt="Pemilwa Tabulated Election Results Dashboard"
                width="1440"
                height="940"
                class="pemilwa-slide pemilwa-slide-3 absolute inset-0 h-full w-full object-cover object-top"
                loading="lazy"
              />
            </div>

            <!-- Slide indicator dots -->
            <div aria-hidden="true" class="pointer-events-none absolute bottom-3 right-3 z-10 flex items-center gap-1.5 rounded-full bg-neutral-900/60 px-2.5 py-1 backdrop-blur-xs">
              <span class="pemilwa-dot pemilwa-dot-1 h-1.5 w-1.5 rounded-full bg-white"></span>
              <span class="pemilwa-dot pemilwa-dot-2 h-1.5 w-1.5 rounded-full bg-white"></span>
              <span class="pemilwa-dot pemilwa-dot-3 h-1.5 w-1.5 rounded-full bg-white"></span>
            </div>
          </a>
          <div class="p-5 sm:p-6">
            <div class="flex items-center gap-2">
              <ProjectIcon slug="pemilwa-evoting" size="sm" />
              <p class="font-mono text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400" id="featured">
                Featured System
              </p>
            </div>
            <h2 class="mt-2 block text-balance text-xl font-semibold leading-snug tracking-tight hover:underline md:text-2xl dark:text-neutral-100">
              <a href={entryHref('systems', pemilwa.data.slug)}>
                High-concurrency campus election engine with 100% uptime since 2020.
              </a>
            </h2>
            <p class="mt-2 text-base leading-relaxed text-neutral-600 dark:text-neutral-300">
              Serving 39,725 eligible voters across 8 faculties with lightweight Native PHP,
              atomic PostgreSQL row locking, and institutional CAS single sign-on on university
              on-premise servers — zero failed requests across 5 consecutive election cycles.
            </p>
            <div class="mt-3.5 flex flex-wrap gap-1.5">
              {pemilwa.data.evidence.map((e) => (
                <EvidencePill type={e.type} label={e.label} url={e.url} status={e.status} />
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Three competencies -->
  {
    competencies.map((c) => (
      <section class="mt-16" aria-labelledby={`comp-${c.id}`}>
        <div class="flex items-center gap-2.5">
          <ProjectIcon name={sectionIcons[c.id]} size="sm" />
          <h2 id={`comp-${c.id}`} class="text-balance text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
            {c.title}
          </h2>
        </div>
        <p class="mt-1.5 text-base text-neutral-600 dark:text-neutral-400">{c.blurb}</p>
        <div class="mt-4 rounded-xl border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-800 dark:bg-[#222226]">
        <ul class="divide-y divide-neutral-100 dark:divide-neutral-800">
          {c.rows.map((r) => (
            <li class="py-4 first:pt-0 last:pb-0">
              <div class="flex items-start gap-3.5">
                <a href={r.href} tabindex="-1" aria-hidden="true" class="mt-0.5 shrink-0 transition-transform hover:scale-105 focus:outline-none">
                  <ProjectIcon slug={r.slug} name={r.iconName} image={r.image} size="sm" />
                </a>
                <div class="min-w-0 flex-1">
                  <a
                    href={r.href}
                    class="group block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 focus-visible:ring-offset-1 rounded-sm"
                  >
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
