                    <p class="mt-1 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">{r.summary}</p>
                  </a>
                  {
                    r.excerpt && (
                      <blockquote class="mt-2.5 border-l-2 border-neutral-300 pl-3 italic text-sm leading-relaxed text-neutral-600 dark:border-neutral-700 dark:text-neutral-400">
