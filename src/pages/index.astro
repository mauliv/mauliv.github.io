          <div class="flex flex-col justify-between rounded-xl border border-neutral-200 bg-white p-5 shadow-sm transition-all duration-200 hover:border-neutral-300 dark:border-neutral-800 dark:bg-[#222226] dark:hover:border-neutral-700">
            <div>
              <div class="mb-3">
                <a href={i.href} tabindex="-1" aria-hidden="true" class="inline-block transition-transform hover:scale-105 focus:outline-none">
                  <ProjectIcon slug={i.slug} name={i.name} size="sm" />
                </a>
              </div>
              <dt>
                <a
                  href={i.href}
                  class="font-mono text-2xl font-bold tracking-tight text-neutral-900 underline decoration-neutral-300 underline-offset-4 transition-colors hover:decoration-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 focus-visible:ring-offset-1 rounded-sm dark:text-neutral-100 dark:decoration-neutral-700 dark:hover:decoration-neutral-100"
                >
                  {i.value}
                </a>
              </dt>
              <dd class="mt-1.5 text-xs leading-relaxed text-neutral-600 dark:text-neutral-400">{i.label}</dd>
            </div>
            {i.pill && (
              <div class="mt-3.5">
                <EvidencePill type={i.pill.type} label={i.pillLabel ?? i.pill.label} url={i.pill.url} status={i.pill.status} />
              </div>
            )}
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Index: every track, one taxonomy -->
  <section class="mt-16" aria-label="All sections">
    <h2 class="text-balance text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">Index</h2>
    <div class="mt-4 rounded-xl border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-800 dark:bg-[#222226]">
    <ul class="grid grid-cols-1 gap-x-8 sm:grid-cols-2">
      {
        indexLinks.map((l) => (
          <li class="border-b border-neutral-100 py-1 last:border-b-0 sm:last:border-b dark:border-neutral-800/80">
            <a
              href={l.href}
              class="group flex min-h-11 items-baseline justify-between gap-3 py-1 text-sm transition-colors hover:text-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 focus-visible:ring-offset-1 rounded-sm dark:text-neutral-300 dark:hover:text-neutral-100"
            >
              <span class="min-w-0 break-words group-hover:underline underline-offset-2">{l.label}</span>
              {l.count > 0 && <span class="font-mono text-xs text-neutral-500 dark:text-neutral-400">{l.count}</span>}
            </a>
          </li>
        ))
      }
    </ul>
    </div>
  </section>

  <!-- Evidence System Guarantee & Current Focus -->
  <div class="mt-12 space-y-3 text-center font-mono text-xs text-neutral-500 dark:text-neutral-400">
    <p>
      Every claim on this site links to primary proof — live systems, PDFs, government HKI registries, journal DOIs, or press reports.
    </p>
    <p>
      <span class="font-semibold text-neutral-700 dark:text-neutral-300">Now:</span> Expanding fullstack &amp; EdTech AR prototypes, actively interviewing for engineering roles.
    </p>
  </div>
</Layout>

