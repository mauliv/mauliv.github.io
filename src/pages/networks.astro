---

<Layout
  title="IT Support & Networks"
  description="From physical layer to campus infrastructure: vocational networking, field practice, national certification, and enterprise systems operations."
>
  <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'IT Support & Networks' }]} />

  <div class="mt-4 flex items-center gap-2.5">
    <ProjectIcon name="networks" size="sm" />
    <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
      IT Support &amp; Networks
    </h1>
  </div>
  <p class="mt-2 text-base text-neutral-600 dark:text-neutral-400">
    From the physical layer up: vocational networking, field practice, national certification, and campus infrastructure operations.
  </p>

  <div class="mt-8 space-y-4">
    {
      networkProjects.map((project) => (
        <ProjectCard
          title={project.title}
          role={project.role}
          period={project.period}
          track={project.track}
          slug={project.slug}
          project_logo={project.project_logo}
          institution_logo={project.institution_logo}
          tech_stack={project.tech_stack}
          metrics={project.metrics}
          evidence={project.evidence}
          summary={project.summary}
          headingLevel="h2"
          href={project.href}
        />
      ))
    }
  </div>
</Layout>
