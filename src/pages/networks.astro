---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectIcon from '../components/ProjectIcon.astro';

interface EvidenceItem {
  type: 'internal-pdf' | 'journal' | 'hki' | 'external-press' | 'video' | 'live' | 'repository';
  label: string;
  url: string;
  is_internal: boolean;
  status: 'available' | 'needs-confirmation' | 'restricted';
}

interface NetworkProject {
  title: string;
  role: string;
  period: { start: string; end: string };
  track: string;
  slug: string;
  project_logo: string;
  institution_logo?: string;
  summary: string;
  tech_stack: string[];
  metrics: { label: string; value: string; provenance?: string }[];
  evidence: EvidenceItem[];
  href: string;
}

const networkProjects: NetworkProject[] = [
  {
    title: 'Vocational High School Diploma in Computer Network Engineering',
    role: 'Vocational Student in Computer Network Engineering',
    period: { start: '2016', end: '2019' },
    track: 'vocational engineering',
    slug: 'smk-tkj',
    project_logo: '/logos/smkn3.png',
    institution_logo: '/logos/smkn3.png',
    summary:
      'Three years of rigorous Computer Network Engineering education at SMK Negeri 3 Yogyakarta (graduated with 85.3/100 average score). Built core competencies across physical Layer 1 structured cabling, Cisco and MikroTik routing and switching, Linux server administration, and early electoral software engineering.',
